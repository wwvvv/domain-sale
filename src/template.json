{
  "html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#0b1220\">\n  <meta name=\"description\" content=\"{{DESCRIPTION}}\">\n  <title>{{DOMAIN}} · 域名出售</title>\n  <style>\n    :root{color-scheme:dark;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif}\n    *{box-sizing:border-box}\n    body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 50% 5%,#203558 0%,#101a2d 41%,#0b1220 78%);color:#f8fafc;display:grid;place-items:center}\n    main{width:min(840px,100%);text-align:center;padding:28px 22px 35px}\n    header{display:flex;justify-content:flex-end;align-items:center;min-height:42px}\n    .language{color:#dbe5f7;background:#19283f;border:1px solid #34475f;border-radius:9px;padding:9px 13px;font-size:12px;min-width:136px;cursor:pointer}\n    .language:focus-visible,.button:focus-visible{outline:2px solid #b2baff;outline-offset:3px}\n    .hero{padding:64px 0 14px}\n    .eyebrow{font-size:11px;font-weight:800;letter-spacing:.2em;color:#a6b6ff}\n    h1{font-size:clamp(45px,9vw,88px);letter-spacing:-.065em;line-height:1.1;overflow-wrap:anywhere;margin:27px 0 19px;font-weight:800}\n    .subtitle{font-size:15px;color:#b0bed3;margin:0}\n    .sale-price{font-size:clamp(33px,5vw,48px);font-weight:800;letter-spacing:-.03em;margin:13px 0 29px}\n    .section-label{color:#98a9c3;font-size:12px;font-weight:600}\n    .meaning{margin:32px auto 34px}\n    .meaning-chips{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin-top:13px}\n    .meaning-chip{border:1px solid #35445e;background:#19263d;border-radius:10px;padding:9px 16px;font-size:15px;color:#edf2fc}\n    .button{display:inline-flex;align-items:center;justify-content:center;min-width:180px;min-height:48px;padding:13px 24px;background:#6366f1;border-radius:11px;font-size:14px;font-weight:700;color:white;text-decoration:none;transition:background .15s}\n    .button:hover{background:#4f46e5}\n    .email{display:block;color:#97abca;font-size:13px;margin-top:16px;text-decoration:none}\n    .email:hover{color:white}\n    footer{color:#889dbd;font-size:12px;margin-top:62px;line-height:1.7}\n    @media(max-width:480px){\n      main{padding:17px 18px 27px}.hero{padding-top:55px}h1{margin-top:24px}\n      .meaning{margin:27px auto}.meaning-chip{padding:8px 12px}footer{margin-top:54px}\n    }\n  </style>\n  <script src=\"/assets/client.js\" defer></script>\n</head>\n<body>\n  <main>\n    <header>\n      <select class=\"language\" id=\"language-select\" aria-label=\"Choose language\">\n        <option value=\"auto\">🌐 Auto / 自动</option>\n        <option value=\"zh-CN\">简体中文</option>\n        <option value=\"en\">English</option>\n        <option value=\"zh-TW\">繁體中文</option>\n        <option value=\"ja\">日本語</option>\n        <option value=\"ko\">한국어</option>\n        <option value=\"fr\">Français</option>\n        <option value=\"de\">Deutsch</option>\n        <option value=\"es\">Español</option>\n        <option value=\"ru\">Русский</option>\n        <option value=\"pt\">Português</option>\n        <option value=\"ar\">العربية</option>\n        <option value=\"th\">ไทย</option>\n        <option value=\"vi\">Tiếng Việt</option>\n        <option value=\"id\">Bahasa Indonesia</option>\n        <option value=\"it\">Italiano</option>\n        <option value=\"nl\">Nederlands</option>\n      </select>\n    </header>\n    <div class=\"hero\">\n      <div class=\"eyebrow\" data-i18n=\"badge\">PREMIUM DOMAIN</div>\n      <h1 id=\"sale-domain\">{{DOMAIN}}</h1>\n      <p class=\"subtitle\" data-i18n=\"subtitle\">此域名正在出售</p>\n    </div>\n    <div class=\"section-label\" data-i18n=\"price\">出售价格</div>\n    <div class=\"sale-price\" id=\"sale-price\" data-amount=\"{{AMOUNT}}\" data-currency=\"{{CURRENCY}}\">{{PRICE}}</div>\n    {{MEANING_SECTION}}\n    <a class=\"button\" id=\"contact-link\" data-email=\"{{EMAIL}}\" href=\"{{CONTACT_HREF}}\"\n       data-i18n=\"contact\" rel=\"nofollow\">联系卖家</a>\n    <a class=\"email\" id=\"contact-email\" href=\"{{CONTACT_HREF}}\">{{EMAIL}}</a>\n    <footer data-i18n=\"footer\">有意购买？欢迎联系域名所有者。</footer>\n  </main>\n</body>\n</html>\n"
}
